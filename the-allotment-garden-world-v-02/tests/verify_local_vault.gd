extends SceneTree
const Profiles := preload("res://features/profiles/local_profiles.gd")
const Vault := preload("res://features/vault/local_vault.gd")
const Store := preload("res://features/market/market_store.gd")
func _initialize() -> void: call_deferred("verify")
func verify() -> void:
 var profiles := Profiles.new()
 var first := profiles.create("Aster")
 assert(not first.is_empty())
 var world = load("res://main.tscn").instantiate()
 root.add_child(world)
 await process_frame
 var placement = world.market_garden
 assert(placement.begin("branch_trellis","garden"))
 assert(placement.place_at(Vector2(0,60)))
 placement.finish()
 assert(placement.begin("ivy@seedling","garden"))
 assert(placement.place_at(Vector2(.8,60.55)))
 placement.finish()
 world.player.position = Vector3(2,.12,18)
 world.ensure_ground_editor()
 var ground = world.ground_editor_session.store
 assert(ground.begin_stroke())
 assert(ground.apply_shape({"type":"brush","points":[Vector2(3,60)],"width":2.},ground.catalog.default_style("cobblestone"),"paint") > 0)
 ground.commit_stroke()
 assert(ground.cells.size() > 0)
 assert(preload("res://features/avatar/appearance.gd").save(preload("res://features/avatar/appearance.gd").defaults()))
 world.local_vault._process(60.)
 assert(FileAccess.file_exists(Profiles.save_root()+"session.json"),"One-minute autosave must checkpoint")
 assert(world.local_vault.save(),world.local_vault.last_error)
 var session: Dictionary = world.local_vault.read_session()
 assert(session.position[0] == 2.)
 var folder: String = Profiles.save_root()+"vault/"
 var zip := ZIPReader.new()
 assert(zip.open(folder+"latest.zip") == OK)
 assert(zip.file_exists("market.json") and zip.file_exists("session.json") and zip.file_exists("avatar/appearance.json"))
 assert(zip.file_exists("ground_cover/local_demo_neighborhood_garden_01.json"))
 assert(JSON.parse_string(zip.read_file("market.json").get_string_from_utf8()).placed.size() == 2)
 zip.close()
 world.player.position.x = 3
 assert(world.local_vault.save())
 assert(zip.open(folder+"previous.zip") == OK)
 assert(JSON.parse_string(zip.read_file("session.json").get_string_from_utf8()).position[0] == 2.)
 zip.close()
 var hud = world.get_node("GameHUD")
 hud._open("settings",null)
 var settings = hud.content.get_child(0)
 assert(settings.get_child(2).text == "Save garden now")
 hud._close()
 world.free()
 world = load("res://main.tscn").instantiate()
 root.add_child(world)
 assert(is_equal_approx(world.player.position.x,3.))
 assert(world.market_garden.roots.garden.get_child_count() == 2)
 assert(world.ground_editor_session != null,"Restore landscaping without opening editor")
 assert(world.ground_editor_session.store.cells.size() > 0)
 var ground_path: String = world.ground_editor_session.store.default_save_path()
 var good_ground := FileAccess.get_file_as_string(ground_path)
 var broken_ground := FileAccess.open(ground_path,FileAccess.WRITE)
 broken_ground.store_string("broken landscaping")
 broken_ground.close()
 world.free()
 world = load("res://main.tscn").instantiate()
 root.add_child(world)
 assert(not world.local_vault.save())
 assert(FileAccess.get_file_as_string(ground_path) == "broken landscaping")
 broken_ground = FileAccess.open(ground_path,FileAccess.WRITE)
 broken_ground.store_string(good_ground)
 broken_ground.close()
 world.free()
 world = load("res://main.tscn").instantiate()
 root.add_child(world)
 # Explicit invalid files are preserved instead of replaced by an empty garden.
 var path: String = Profiles.save_root()+"session.json"
 var good := FileAccess.get_file_as_string(path)
 var file := FileAccess.open(path,FileAccess.WRITE)
 file.store_string("broken session")
 file.close()
 assert(not world.local_vault.save())
 assert(FileAccess.get_file_as_string(path) == "broken session")
 file = FileAccess.open(path,FileAccess.WRITE)
 file.store_string(good)
 file.close()
 var market := Store.new()
 file = FileAccess.open(market.path,FileAccess.WRITE)
 file.store_string("broken market")
 file.close()
 assert(not world.local_vault.save())
 assert(FileAccess.get_file_as_string(market.path) == "broken market")
 world.free()
 var second := profiles.create("Fern")
 assert(not second.is_empty() and second != first)
 world = load("res://main.tscn").instantiate()
 root.add_child(world)
 assert(world.market_garden.roots.garden.get_child_count() == 0)
 assert(not is_equal_approx(world.player.position.x,3.))
 assert(world.local_vault.save())
 world.free()
 assert(not Vault.valid_session({"version":1,"position":[NAN,0,0]}))
 print("PASS local vault: named profile checkpoints, manual save, validated rotating ZIP backups, last-position/garden/landscaping restore, Settings controls, corrupt-file preservation and profile isolation")
 quit()
