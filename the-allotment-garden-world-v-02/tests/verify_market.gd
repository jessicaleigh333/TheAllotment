extends SceneTree
const Store := preload("res://features/market/market_store.gd")
const Catalog := preload("res://features/market/catalog.gd")
const Profiles := preload("res://features/profiles/local_profiles.gd")
func _initialize() -> void:
 call_deferred("verify")
func verify() -> void:
 # Use fresh isolated XDG_DATA_HOME. This test creates local profiles.
 var profiles := Profiles.new()
 assert(profiles.read().profiles.is_empty(),"Use a fresh test data directory")
 var a := profiles.create("Market A")
 assert(not a.is_empty())
 var store := Store.new()
 assert(store.data.runes == 1250)
 assert(store.buy("rose"))
 assert(store.data.runes == 1250 and store.count("rose") == 1)
 assert(Store.new().count("rose") == 1)
 var before := store.data.duplicate(true)
 assert(store.buy("sunflower_seeds"))
 before = store.data.duplicate(true)
 assert(not store.buy("unknown") and store.data == before)
 assert(store.favorite("rose"))
 assert(store.data.favorites == ["rose"])
 for i in range(3): assert(store.buy("fountain"))
 var empty_wallet := store.data.duplicate(true)
 empty_wallet.runes = 0
 assert(store._commit(empty_wallet))
 assert(store.buy("fountain") and store.data.runes == 0)
 before = store.data.duplicate(true)
 assert(not store.place("rose",Vector2(NAN,0),0) and store.data == before)
 var b := profiles.create("Market B")
 assert(not b.is_empty())
 assert(Store.new().data.runes == 1250 and Store.new().count("rose") == 0)
 assert(profiles.activate(a))
 assert(Store.new().data.runes == 0 and Store.new().count("rose") == 1)
 var corrupt := FileAccess.open("user://bad_market.json",FileAccess.WRITE)
 corrupt.store_string("{broken")
 corrupt.close()
 var broken := Store.new("user://bad_market.json")
 assert(not broken.readable and not broken.buy("rose"))
 assert(FileAccess.get_file_as_string("user://bad_market.json") == "{broken")
 for item in Catalog.ITEMS:
  if not item.get("available",true): continue
  var model = load("res://features/market/item_model.tscn").instantiate()
  model.item_id = item.id
  root.add_child(model)
  assert(model.get_child_count() > 0,"Missing model: "+item.id)
  model.free()
 var world = load("res://main.tscn").instantiate()
 root.add_child(world)
 await process_frame
 var hud = world.get_node("GameHUD")
 hud._open_market("shop")
 await process_frame
 var screen = hud.market_screen
 assert(screen.card_buttons.size() == Catalog.ITEMS.size()-2)
 screen.category = "Plants"
 screen._refresh_grid()
 assert(screen.card_buttons.size() == 7)
 screen.query = "lavendula"
 screen._refresh_grid()
 assert(screen.card_buttons.is_empty())
 screen.query = "lavandula"
 screen._refresh_grid()
 assert(screen.card_buttons.size() == 1 and screen.card_buttons.has("lavender"))
 screen.query = ""
 screen._select("rose")
 screen._preview("rose")
 assert(screen.preview_model.get_child_count() > 0)
 screen._preview("bench")
 assert(screen.preview_model.item_id == "bench")
 hud._close()
 assert(world.market_garden.begin("rose","garden"))
 assert(world.ui_panel_open and not world.walking_mode)
 var count: int = world.market_garden.store.count("rose")
 assert(not world.market_garden.place_at(Vector2.ZERO))
 assert(not world.market_garden.place_at(Vector2(100,50)))
 assert(world.market_garden.store.count("rose") == count)
 assert(world.market_garden.place_at(Vector2(4,55)))
 assert(world.market_garden.active and world.ui_panel_open)
 world.market_garden.finish()
 assert(world.walking_mode and not world.ui_panel_open)
 assert(Store.new().data.placed.size() == 1 and Store.new().count("rose") == 0)
 assert(not world.market_garden.allowed("fountain",Vector2(4,55)))
 world.market_garden.reload_items()
 assert(world.market_garden.placed_root.get_child_count() == 1)
 hud._open_market("inventory")
 await process_frame
 assert(hud.market_screen.mode == "backpack")
 hud.market_screen._retrieve(0)
 assert(Store.new().count("rose") == 1 and Store.new().data.placed.is_empty())
 assert(world.market_garden.placed_root.get_child_count() == 0)
 hud._close()
 world._open_plant_catalog()
 assert(hud.market_screen.mode == "catalog" and world.ui_panel_open)
 hud._close()
 world.queue_free()
 await process_frame
 print("PASS: free access, ownership, persistence, profile isolation, free additions with empty wallets, corrupt-save preservation, category/Latin search, 3D previews, scoped placement, overlap rejection, retrieval and HUD integration")
 quit()
