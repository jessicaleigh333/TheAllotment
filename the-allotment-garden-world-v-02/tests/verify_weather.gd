extends SceneTree
const Weather := preload("res://features/weather/weather_system.gd")
func _initialize() -> void:
	call_deferred("_verify")
func _verify() -> void:
	var weather := Weather.new()
	weather.set_simulation_time(int(Time.get_unix_time_from_datetime_string("2026-12-30T12:00:00")))
	root.add_child(weather)
	var forecast := weather.forecast()
	assert(forecast.size() == 5)
	assert(forecast[0].date == "2026-12-31")
	assert(forecast[1].date == "2027-01-01")
	assert(forecast == weather.forecast())
	for i in range(5):
		assert(forecast[i].day == weather.current_weather().day + i + 1)
		assert(forecast[i].low_c < forecast[i].high_c)
		assert(forecast[i].rain_chance >= 0 and forecast[i].rain_chance <= 100)
	assert(Weather.temperature(0,true) == "32°F")
	assert(Weather.temperature(0,false) == "0°C")
	weather.set_simulation_time(weather.timestamp() + 86400)
	assert(weather.current_weather().condition == forecast[0].condition)
	assert(weather.current_weather().high_c == forecast[0].high_c)
	weather.queue_free()
	var world = load("res://main.tscn").instantiate()
	root.add_child(world)
	await process_frame
	var hud = world.get_node("GameHUD")
	var provider = world.get_node("GardenWeather")
	provider.set_simulation_time(int(Time.get_unix_time_from_datetime_string("2026-10-13T12:00:00")))
	assert(hud.weather_button.text == provider.temperature(provider.current_weather().temperature_c))
	hud.weather_button.pressed.emit()
	assert(hud.dialog.visible and world.ui_panel_open)
	var panel = hud.content.get_child(0)
	assert(panel.provider == provider)
	assert(panel.forecast_rows.get_child_count() == 5)
	panel.unit_button.pressed.emit()
	assert(not panel.fahrenheit and panel.current_title.text.contains("°C"))
	provider.set_simulation_time(provider.timestamp() + 86400)
	assert(panel.current_details.text.contains("2026-10-14"))
	assert(hud.weather_button.text == provider.temperature(provider.current_weather().temperature_c))
	var escape := InputEventKey.new()
	escape.keycode = KEY_ESCAPE
	escape.pressed = true
	hud._unhandled_input(escape)
	assert(not hud.dialog.visible and not world.ui_panel_open)
	world.queue_free()
	await process_frame
	print("PASS: deterministic five-day forecast, year rollover, forecast matches next day's conditions, units, main-screen temperature, shared panel provider, refresh and Escape dismissal")
	quit()
