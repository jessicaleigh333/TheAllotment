extends SceneTree
const Profiles := preload("res://features/profiles/local_profiles.gd")
const Appearance := preload("res://features/avatar/appearance.gd")
func _initialize() -> void:
 call_deferred("verify")
func verify() -> void:
 # Run using an isolated XDG_DATA_HOME: this test deliberately creates local profiles.
 var profiles := Profiles.new("user://profile_test/index.json")
 assert(profiles.create(" ").is_empty())
 var a := profiles.create("Rose")
 assert(not a.is_empty())
 assert(profiles.create("rose").is_empty())
 var b := profiles.create("Willow")
 assert(a != b and profiles.read().profiles.size() == 2)
 assert(profiles.activate(a))
 assert(Profiles.new("user://profile_test/index.json").read().active == a)
 assert(not profiles.activate("../bad"))
 # Verify the actual save scoping with the default index in the isolated test directory.
 var live := Profiles.new()
 assert(live.read().profiles.is_empty(),"Use a fresh test user data directory")
 var legacy := Appearance.defaults()
 legacy.hair_style = "bob"
 assert(Appearance.save(legacy,Appearance.PATH))
 a = live.create("First")
 assert(not a.is_empty())
 var a_root := Profiles.save_root()
 assert(Appearance.load_saved().hair_style == "bob","Legacy appearance must copy into first profile")
 b = live.create("Second")
 assert(not b.is_empty() and Profiles.save_root() != a_root)
 assert(Appearance.load_saved().hair_style == "long","New profiles must not inherit another profile's appearance")
 var second := Appearance.defaults()
 second.hair_style = "bun"
 assert(Appearance.save(second))
 var store = preload("res://features/garden_editor/ground_cover/surface_store.gd").new()
 var second_path: String = store.default_save_path()
 assert(live.activate(a))
 assert(store.default_save_path() != second_path)
 assert(Appearance.load_saved().hair_style == "bob")
 assert(Appearance.load_saved(Appearance.PATH).hair_style == "bob","Legacy source must remain unchanged")
 store.free()
 var invalid := FileAccess.open("user://profile_test/broken.json",FileAccess.WRITE)
 invalid.store_string("{broken")
 invalid.close()
 var broken := Profiles.new("user://profile_test/broken.json")
 assert(broken.read().is_empty() and broken.create("Keep saves").is_empty())
 print("PASS: local profile persistence/validation, duplicate names, corruption preservation, legacy copy, separate avatar and landscaping paths")
 quit()
