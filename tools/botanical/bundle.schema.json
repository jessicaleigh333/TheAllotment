{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:the-allotment:botanical:bundle:1.0.0",
  "type": "object",
  "required": ["schema_version", "input_hash", "content_hash", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "purpose": {"const": "research_only_not_live_gameplay"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plant_id", "publication_status", "registry", "source_records"],
        "additionalProperties": false,
        "properties": {
          "plant_id": {"type": "string", "minLength": 1},
          "publication_status": {"enum": ["research_only", "approved"]},
          "registry": {"type": "object"},
          "source_records": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["record_key", "source_path", "source_pointer", "base_revision", "original", "effective"],
              "properties": {
                "record_key": {"type": "string", "minLength": 1},
                "source_path": {"type": "string", "minLength": 1},
                "source_pointer": {"type": "string", "pattern": "^/"},
                "base_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "original": {"type": "object"},
                "effective": {"type": "object"}
              }
            }
          }
        }
      }
    }
  }
}
